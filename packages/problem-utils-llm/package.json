{
  "name": "@exercode/problem-utils-llm",
  "version": "0.0.0-semantically-released",
  "description": "Exercode llm judging utilities",
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/exercode-problem-utils.git",
    "directory": "packages/problem-utils-llm"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "build-ts lib --input src/index.ts",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "test": "bun wb test",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.123",
    "@ai-sdk/google": "4.0.104",
    "@ai-sdk/openai": "4.0.101",
    "@ai-sdk/xai": "5.0.29",
    "@exercode/problem-utils": "workspace:*",
    "@willbooster/shared-lib": "11.1.0",
    "ai": "7.0.152",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "23.0.2",
    "build-ts": "21.0.31",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "engines": {
    "node": ">=24"
  }
}
