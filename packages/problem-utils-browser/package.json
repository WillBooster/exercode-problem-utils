{
  "name": "@exercode/problem-utils-browser",
  "version": "0.0.0-semantically-released",
  "description": "Exercode browser judging utilities",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/exercode-problem-utils.git",
    "directory": "packages/problem-utils-browser"
  },
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "exercode-browser": "bin/exercode-browser.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "build-ts lib --input src/index.ts src/pdf.ts"
  },
  "dependencies": {
    "@exercode/problem-utils": "workspace:*",
    "highlight.js": "11.11.1",
    "html-encoding-sniffer": "6.0.0",
    "marked": "18.0.11",
    "marked-cjk-friendly": "0.1.1",
    "marked-gfm-heading-id": "4.1.4",
    "prettier": "3.9.6",
    "prettier-plugin-organize-attributes": "1.0.0",
    "puppeteer": "25.9.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/html-encoding-sniffer": "3.0.2",
    "build-ts": "21.0.12"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
