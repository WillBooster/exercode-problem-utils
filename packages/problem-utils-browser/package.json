{
  "name": "@exercode/problem-utils-browser",
  "version": "0.0.0-semantically-released",
  "description": "Exercode browser judging utilities",
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/exercode-problem-utils.git",
    "directory": "packages/problem-utils-browser"
  },
  "bin": {
    "exercode-browser": "bin/exercode-browser.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "build-ts lib --input src/index.ts src/pdf.ts",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "test": "bun wb test",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "@exercode/problem-utils": "workspace:*",
    "@willbooster/shared-lib": "10.23.0",
    "highlight.js": "11.12.0",
    "html-encoding-sniffer": "7.0.0",
    "marked": "18.1.1",
    "marked-cjk-friendly": "0.1.2",
    "marked-gfm-heading-id": "4.1.4",
    "prettier": "3.9.10",
    "prettier-plugin-organize-attributes": "1.0.0",
    "puppeteer": "25.14.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.3",
    "@types/html-encoding-sniffer": "3.0.2",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "22.29.3",
    "build-ts": "21.0.27",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "engines": {
    "node": ">=24"
  }
}
